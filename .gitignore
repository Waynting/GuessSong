# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
dev_docs/

# vercel
.vercel

# cloudflare worker (worker/ is a separate build with its own deps)
# worker-configuration.d.ts IS committed on purpose — it is generated by
# `wrangler types` from wrangler.jsonc and typechecking the worker needs it.
worker/node_modules/
worker/.wrangler/
# Local Worker env (holds your LAN IP for phone testing) — see .dev.vars.example
worker/.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

.gstack/
