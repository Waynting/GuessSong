{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guesssong-buzzer",
  "main": "src/index.ts",

  // 2026-04-07 is the floor for `web_socket_auto_reply_to_close`, which makes
  // the runtime answer close frames for hibernated objects without waking them.
  // Waking a DO just to say goodbye is the single easiest way to turn a free
  // room into a billed one.
  "compatibility_date": "2026-07-01",

  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "BUZZER_ROOM", "class_name": "BuzzerRoom" }]
  },

  // Per-IP throttle on the two public entry points (see rateLimited() in
  // src/index.ts). Without it the WebSocket upgrade is an unmetered oracle for
  // "does this room code exist", and the 4-character code space is small enough
  // to walk. Namespace ids are local to this Worker and only have to be
  // distinct; they are not account-wide resources to provision.
  //
  // Two limiters because the two endpoints deserve very different budgets.
  // Joining: 60/min, enough for a whole party arriving at once on one shared
  // Wi-Fi NAT, plus the client's reconnect backoff on a bad network.
  // Creating: 15/min. Each create claims a Durable Object, so it wants to be
  // the tighter of the two — but not as tight as "one room per party" suggests,
  // because changing Game Mode on the setup page discards the open room and the
  // next "Open Room" claims a fresh one. A host who changes their mind five
  // times while setting up is not a flood.
  "ratelimits": [
    { "name": "BUZZER_JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "BUZZER_CREATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 15, "period": 60 } }
  ],

  // SQLite-backed classes are the only kind available on the Workers Free plan,
  // and they're what the KV-style `ctx.storage.put/get` API runs on top of here.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BuzzerRoom"] }],

  "vars": {
    // Browsers send Origin on the WebSocket upgrade; anything not on this list
    // is refused at the Worker before it can reach (and therefore instantiate)
    // a Durable Object.
    //
    // Entries may contain `*`, which matches any run of non-`/` characters.
    // The Vercel entries are globs because preview deployments get a fresh
    // hostname per branch — pinning them exactly would mean redeploying this
    // Worker for every branch anyone pushes. Both are anchored to this
    // project's name, so they don't open the door to vercel.app at large.
    //
    // For LAN testing on real phones, put your machine's IP in worker/.dev.vars
    // instead of here — see .dev.vars.example.
    "ALLOWED_ORIGINS": "https://www.guessong.app,https://guessong.app,http://127.0.0.1:8000,http://localhost:8000,https://spotify-song-guess-web-*.vercel.app,https://guesssong-*.vercel.app"
  }
}
